<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Automation Suite" parallel="tests" thread-count="3">

    <!-- 🔥 Extent Report Listener -->
    <listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>

    <!-- ================= SMOKE ================= -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>

    <!-- ================= REGRESSION ================= -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
                <include name="crud"/>
                <include name="integration"/>
            </run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>

    <!-- ================= NEGATIVE ================= -->
    <test name="Negative Tests">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>

    <!-- ================= SECURITY ================= -->
    <test name="Security Tests">
        <groups>
            <run>
                <include name="security"/>
            </run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>

</suite>