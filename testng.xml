
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Suite" parallel="methods" thread-count="10">

    <listeners>
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <test name="UsersTest">

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="tests"/>
        </packages>

    </test>

</suite>