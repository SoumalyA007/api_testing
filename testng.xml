<suite name="API Automation Suite" parallel="tests" thread-count="3">

<listeners>
    <listener class-name="listeners.RetryListener"/>
</listeners>

    <!-- 🔥 Smoke Tests (Fast Feedback) -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.AuthTest"/>
            <class name="tests.ProductsTest"/>
            <class name="tests.CartsTest"/>
            <class name="tests.UsersTest"/>
            <class name="tests.InventoryTest"/>
            <class name="tests.OrdersTest"/>
        </classes>
    </test>

    <!-- 🔥 CRUD + Regression -->
    <test name="CRUD & Regression Tests">
        <groups>
            <run>
                <include name="crud"/>
                <include name="regression"/>
                <include name="integration"/>
            </run>
        </groups>
        <classes>
            <class name="tests.ProductsTest"/>
            <class name="tests.CartsTest"/>
            <class name="tests.UsersTest"/>
            <class name="tests.InventoryTest"/>
            <class name="tests.OrdersTest"/>
            <class name="tests.CategoriesTest"/>
        </classes>
    </test>

    <!-- 🔥 Negative + Security -->
    <test name="Negative & Security Tests">
        <groups>
            <run>
                <include name="negative"/>
                <include name="security"/>
            </run>
        </groups>
        <classes>
            <class name="tests.AuthTest"/>
            <class name="tests.SecurityTest"/>
            <class name="tests.ProductsTest"/>
            <class name="tests.UsersTest"/>
            <class name="tests.InventoryTest"/>
            <class name="tests.OrdersTest"/>
        </classes>
    </test>

</suite>